        { "name": "Delete Elastic Data", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/elastic/{{elasticId}}", "host": ["{{baseUrl}}"], "path": ["elastic", "{{elasticId}}"] } } }
