        { "name": "Search Elastic By Name And App", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/elastic?name={{elasticName}}&app={{elasticApp}}", "host": ["{{baseUrl}}"], "path": ["elastic"], "query": [{ "key": "name", "value": "{{elasticName}}" }, { "key": "app", "value": "{{elasticApp}}" }] } } },
