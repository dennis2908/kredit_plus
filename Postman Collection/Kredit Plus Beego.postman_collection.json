        { "name": "Generate Konsumen Excel", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/konsumen_excel/{{filename}}", "host": ["{{baseUrl}}"], "path": ["konsumen_excel", "{{filename}}"] } } },
        { "name": "Read Konsumen Excel", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/konsumen_excel_read/{{filename}}", "host": ["{{baseUrl}}"], "path": ["konsumen_excel_read", "{{filename}}"] } } }
